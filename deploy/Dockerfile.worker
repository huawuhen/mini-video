# 生产 Worker 镜像（M2-OPS-01）：在 API 镜像之上加装 ffmpeg 与中文字体（fonts-noto-cjk，
# AGENTS.md §6：平台相关能力按 Linux 容器设计并在镜像内验证）。
# 构建期在镜像内跑 render 测试（真实 ffmpeg）——任务验收项；本地快速构建可
# --build-arg RUN_RENDER_TESTS=false 跳过，但发版镜像必须跑。
# 依赖布局：npm workspaces——先全量 npm ci -w server（测试需 devDeps），测完 prune 成生产依赖。
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg fonts-noto-cjk ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY server/package.json server/
RUN npm ci --workspace=server

COPY server/src server/src
COPY server/test server/test

ARG RUN_RENDER_TESTS=true
RUN cd server && if [ "$RUN_RENDER_TESTS" = "true" ]; then node --test --test-concurrency=1 "test/render/**/*.test.js"; fi

RUN npm prune --omit=dev && rm -rf server/test

# 字体与 ffmpeg 就位自检（拼接/显式标识依赖中文字体）
RUN fc-list :lang=zh family | grep -i -m1 noto && ffmpeg -version | head -1

# 构建期断言：生产环境绝不能注册 local-mock（与 Dockerfile.api 同款）
RUN cd server && node --input-type=module -e " \
  const { loadDriverRegistry } = await import('./src/engine/providers/index.js'); \
  const registry = await loadDriverRegistry(); \
  if (registry.has('local-mock')) throw new Error('local-mock must not load in production');"

USER node
WORKDIR /app/server
CMD ["node", "src/worker.js"]
