# 生产 API 镜像（M2-OPS-01）：Ubuntu/Debian 系 node:22-bookworm-slim，Linux amd64 为准，
# 开发机 arm64 亦可本地构建（docker buildx --platform）。同时充当 migrate / admin:create /
# channel:seed 的一次性运行容器（见 deploy/compose.yml 与 deploy/README.md）。
# 镜像不含任何密钥：.env 由 Compose env_file 在运行时注入（.dockerignore 防误拷）。
# 依赖布局：npm workspaces——lock 在仓库根，npm ci -w server 只装 server 的生产依赖。
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY server/package.json server/
RUN npm ci --omit=dev --workspace=server

COPY server/src server/src
COPY server/migrations server/migrations
COPY server/scripts server/scripts

# 构建期断言（M2-WEB-01 devOnly 契约）：生产环境绝不能注册 local-mock 联调驱动
RUN cd server && node --input-type=module -e " \
  const { loadDriverRegistry } = await import('./src/engine/providers/index.js'); \
  const registry = await loadDriverRegistry(); \
  if (registry.has('local-mock')) throw new Error('local-mock must not load in production'); \
  console.log('driver check ok:', registry.list().map((d) => d.id).join(','));"

USER node
EXPOSE 3000
WORKDIR /app/server
CMD ["node", "src/app.js"]
