# ═══════════════════════════════════════════════════════════════════════════
# Mini AI Video 生产部署配置（M2-OPS-01）
# 用法：cp deploy/.env.production.example deploy/.env && 逐项填写后按 deploy/README.md 启动。
# 只含生产项；开发环境配置请用仓库根的 server/.env.example（两份不通用、不混填）。
# 镜像本身不含任何密钥，本文件经 Compose env_file 运行时注入，绝不提交进仓库。
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ── 数据库 ──
# POSTGRES_PASSWORD 只用字母和数字（不含 $ / : @ 等特殊字符），避免 DATABASE_URL 需要 URL 编码出错；
# 同一个密码要填进下面 DATABASE_URL 的对应位置
POSTGRES_USER=miv
POSTGRES_PASSWORD=
POSTGRES_DB=miv
DATABASE_URL=postgres://miv:填上面的密码@postgres:5432/miv

# ── 网络与安全 ──
# 反向代理（web 容器 nginx）后按 IP 限流依赖此值：容器内是一层代理填 1；
# 若在 Compose 之外又加了外层 nginx/caddy 或云 CDN（见 README §8），要相应调大并按
# README §8 的方法核对（管理端审计日志里应为真实客户端 IP，而不是代理 IP）
TRUST_PROXY_HOPS=1
# 站点自己的地址（写操作 CSRF 校验 Origin 用），逗号分隔可多个
ALLOWED_ORIGINS=http://服务器IP:8080
# 会话 Cookie 的 Secure 标记：
#   用 IP + HTTP 内测阶段 → false（否则浏览器在 http 下不回传 Cookie，无法登录）
#   启用 HTTPS 正式上线后 → 必须改 true 并重启（docker compose up -d），否则 Cookie 可经明文传输
COOKIE_SECURE=false

# ── 渠道凭证主密钥（务必先做离线备份）──
# ≥32 字节随机串（服务器上生成：openssl rand -base64 32）
# ⚠️ 立刻抄到密码管理器或纸面离线保存：丢失后数据库里已加密的全部渠道密钥都无法解密，只能逐个重录
CHANNEL_SECRET_KEY=

# ── 对象存储（七牛 Kodo 私有桶，用户 2026-10-21 定）──
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=redith-h5
QINIU_DOMAIN=https://cdnh5.redith.cn
QINIU_REGION=z0
STORAGE_DRIVER=qiniu
# 上传/下载签名链接有效期（秒）；作品视频保存 3 个月，下载链接按需重签
SIGNED_URL_TTL_SECONDS=3600

# ── 生成渠道（经数据库渠道路由；首次部署后按 README「首次部署清单」seed 写入）──
GEN_UPSTREAMS=real
# aiide（生效）：视频火山方舟协议 + 图片 OpenAI Images
AIIDE_BASE_URL=https://www.aiide.com
AIIDE_API_KEY=
GENERATION_VIDEO_MODEL=dreamina-seedance-2-5-hc
GENERATION_VIDEO_GENERATE_AUDIO=true
GENERATION_IMAGE_MODEL=gpt-image-2
GENERATION_IMAGE_RESOLUTION=1k
GENERATION_IMAGE_RATIO=1:1
GENERATION_IMAGE_QUALITY=
GENERATION_IMAGE_MAX_REFERENCES=1
# 喵呜（备用；不填密钥则不种入）
MIAOWU_BASE_URL=https://api.miaowuai.store
MIAOWU_API_KEY=
MIAOWU_VIDEO_MODEL=seedance-2.5-deal
MIAOWU_IMAGE_MODEL=GPT-image-2
PROVIDERS_IMAGE_POLL_INTERVAL_MS=5000
PROVIDERS_IMAGE_POLL_TIMEOUT_MS=600000
# 文本 LLM（智谱，OpenAI Compatible）
STORY_LLM_BASE_URL=
STORY_LLM_API_KEY=
STORY_LLM_MODEL=glm-4.6

# ── 生成链路参数 ──
# 渠道结果 URL 跨境下载实测约 9KB/s（M2-BE-03-e2e），720p 片段需 5~7 分钟；
# 缺省 5 分钟不够会把任务空转到「结果待核对」——生产保持 20 分钟
PROJECTS_VIDEO_DOWNLOAD_TIMEOUT_MS=1200000

# ── 短信 ──
# 真实通道 M3 接入前的占位（验证码打进 api 容器日志，仅限内测）：
#   docker compose logs api | grep sms:log
# ⚠️ 正式上线前必须接入真实短信并替换此值
SMS_PROVIDER=log

# ── Web 对外端口 ──
WEB_PORT=8080
