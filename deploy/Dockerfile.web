# 生产 Web 镜像（M2-OPS-01）：构建期把前端打成静态文件（真实 API 模式），nginx 托管并反代 /api。
# VITE_USE_MOCK=false 在构建时烙进产物；接口地址走同源 /api（nginx 反代到 api 容器），无 CORS 配置。
# 依赖布局：npm workspaces——lock 在仓库根，npm ci -w @miv/web 装前端依赖。
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
RUN npm ci --workspace=@miv/web
COPY apps/web apps/web
# M3-LEGAL-01 必改①：协议正文经 ?raw 构建时导入（.dockerignore 已放行 docs/legal）
COPY docs/legal docs/legal
RUN cd apps/web && VITE_USE_MOCK=false npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
